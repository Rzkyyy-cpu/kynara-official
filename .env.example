# Salin file ini menjadi .env.local lalu isi nilainya.
# .env.local TIDAK ikut ke git, jadi kunci rahasia aman di laptop masing-masing.
#
# Aturan penamaan Next.js:
#   NEXT_PUBLIC_...  -> boleh terlihat di browser (bukan rahasia)
#   tanpa awalan     -> hanya bisa dibaca di server (RAHASIA)

# Alamat website (dipakai untuk link di email, sitemap, dll.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Fase 2) — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Midtrans sandbox (Fase 5) — dashboard.sandbox.midtrans.com > Settings > Access Keys
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Tes database (npm run test:db) — OPSIONAL. Isi dengan project Supabase KHUSUS TES.
# Kalau kosong, tes memakai project utama di atas (data tes berawalan "zz-tes" dan dihapus lagi).
TEST_SUPABASE_URL=
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SECRET_KEY=
